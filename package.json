{
  "version": "5.0.0",
  "license": "MIT",
  "name": "rosetty-react",
  "description": "",
  "author": "qlaffont",
  "repository": {
    "type": "git",
    "url": "https://github.com/qlaffont/rosetty-react.git"
  },
  "bugs": {
    "url": "https://github.com/qlaffont/rosetty-react/issues",
    "email": "contact@qlaffont.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "start": "bun x bunup --watch",
    "build": "bun x bunup",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "lint": "oxlint src test bunup.config.ts",
    "format": "oxfmt src test bunup.config.ts bunfig.toml .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt src test bunup.config.ts bunfig.toml .oxlintrc.json .oxfmtrc.json --check",
    "prepare": "bun run build"
  },
  "dependencies": {
    "rosetty": "^5.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.13",
    "@types/react": "19.2.14",
    "bunup": "0.16.31",
    "happy-dom": "^20.9.0",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  }
}